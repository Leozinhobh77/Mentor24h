{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "dockerfile",
    "buildCommand": "npm ci && npm run build"
  },
  "deploy": {
    "startCommand": "npm start",
    "restartPolicyMaxRetries": 5,
    "restartPolicyWindowSeconds": 600,
    "healthchecks": {
      "liveness": {
        "command": ["node", "-e", "require('http').get('http://localhost:3000/api/twilio/health', (r) => {if (r.statusCode !== 200) throw new Error(r.statusCode)})"],
        "interval": 30,
        "timeout": 3,
        "startPeriod": 5,
        "successThreshold": 1,
        "failureThreshold": 3
      }
    },
    "ports": [
      {
        "name": "http",
        "port": 3000,
        "protocol": "TCP"
      }
    ]
  },
  "environmentVariables": [
    "DATABASE_URL",
    "NEXT_PUBLIC_SUPABASE_URL",
    "NEXT_PUBLIC_SUPABASE_ANON_KEY",
    "SUPABASE_SERVICE_ROLE_KEY",
    "TWILIO_ACCOUNT_SID",
    "TWILIO_AUTH_TOKEN",
    "TWILIO_PHONE_NUMBER",
    "CLAUDE_API_KEY",
    "INNGEST_EVENT_KEY",
    "INNGEST_SIGNING_KEY",
    "INNGEST_API_KEY",
    "NODE_ENV=production",
    "NEXT_PUBLIC_APP_URL"
  ]
}
