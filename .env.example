# === SUPABASE ===
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# === DATABASE ===
DATABASE_URL=postgresql://user:password@localhost:5432/mentor24h

# === TWILIO (WhatsApp) ===
# Obter em: console.twilio.com > Account > Account Info
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Obter em: console.twilio.com > Account > Account Info > Auth Token
TWILIO_AUTH_TOKEN=your_auth_token_here
# Número no formato: whatsapp:+14155238886 (sandbox) ou seu número aprovado
# Preferido: TWILIO_PHONE_NUMBER (legacy: TWILIO_WHATSAPP_NUMBER)
TWILIO_PHONE_NUMBER=whatsapp:+1415523xxxx

# === CLAUDE API (10% Routines) ===
CLAUDE_API_KEY=sk-ant-v0-xxxxxxxxxxxxxxxxxxxxxxxx

# === INNGEST (Message Queue) ===
# Obter em: app.inngest.com > Settings > Keys
INNGEST_EVENT_KEY=eventkeyhere
INNGEST_SIGNING_KEY=sigkeyhere
INNGEST_API_KEY=inngest_xxx
# Para dev local (opcional): descomente para usar Inngest Dev Server
# INNGEST_API_BASE_URL=http://localhost:8288

# === VERCEL (Deploy + Cron) ===
# (Preenchido automaticamente em produção)
VERCEL_ENV=production
VERCEL_URL=mentor24h.vercel.app
NEXT_PUBLIC_APP_URL=https://mentor24h.vercel.app

# === SENTRY (Error Tracking) ===
# SENTRY_AUTH_TOKEN=sntrys_xxxxx (opcional para MVP)

# === APP ===
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# === TESTING & MOCK MODE ===
# Set to true to mock Twilio calls (log OTP codes instead of sending)
TWILIO_MOCK_MODE=false
